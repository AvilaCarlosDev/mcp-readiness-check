{
  "name": "@avilacarlosdev/mcp-doctor",
  "version": "0.2.0",
  "description": "Bilingual CLI doctor for MCP servers: connect, inspect tools, validate schemas and generate JSON/Markdown reports before wiring a server into your agent.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "developer-tools",
    "diagnostics",
    "validation",
    "agents",
    "llm-tooling",
    "stdio"
  ],
  "homepage": "https://github.com/AvilaCarlosDev/mcp-doctor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvilaCarlosDev/mcp-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/AvilaCarlosDev/mcp-doctor/issues"
  },
  "author": "Carlos Avila <https://github.com/AvilaCarlosDev>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-doctor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "mcp-doctor.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
