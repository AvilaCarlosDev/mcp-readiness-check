{
  "name": "@avilacarlosdev/mcp-readiness-check",
  "version": "0.3.0",
  "description": "Verify stdio MCP server capabilities, paginated catalogs, JSON Schemas, and static security before connecting an agent.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "developer-tools",
    "readiness",
    "security-audit",
    "json-schema",
    "validation",
    "agents",
    "llm-tooling",
    "stdio"
  ],
  "homepage": "https://github.com/AvilaCarlosDev/mcp-readiness-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvilaCarlosDev/mcp-readiness-check.git"
  },
  "bugs": {
    "url": "https://github.com/AvilaCarlosDev/mcp-readiness-check/issues"
  },
  "author": "Carlos Avila <https://github.com/AvilaCarlosDev>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-readiness-check": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "mcp-readiness.config.example.json",
    "report.example.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "pack:check": "npm run build && node scripts/check-pack.mjs",
    "demo:assets:portable": "npm run build && node scripts/generate-demo-assets.mjs",
    "dev": "tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test && node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
